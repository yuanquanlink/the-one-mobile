# Safe default: the bridge is reachable only from this computer.
THE_ONE_BRIDGE_HOST=127.0.0.1
THE_ONE_BRIDGE_PORT=4317

# Required when THE_ONE_BRIDGE_HOST is not a loopback address.
# Generate a long random value; never commit the real token.
THE_ONE_BRIDGE_TOKEN=

# Optional. Defaults to bridge/data/state.json.
THE_ONE_BRIDGE_DATA=

# Optional local fixture root for knowledge search/archive. Never point this at
# D:\AI_Knowledge during development or tests.
THE_ONE_KNOWLEDGE_ROOT=
